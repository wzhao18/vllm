worker_processes 8;
http {
    client_max_body_size 45m;
    access_log off;
    map $http_x_dynamo_session_id $frontend_hash_key { default $http_x_dynamo_session_id; "" $request_id; }
    keepalive_timeout 600s;
    upstream backend_servers {
        hash $frontend_hash_key consistent;
__SERVERS__
        keepalive 512;
        keepalive_timeout 600s;
    }
    server {
        listen 8000;
        location / {
            proxy_pass http://backend_servers;
            proxy_buffering off;
            proxy_read_timeout 24h;
            proxy_send_timeout 24h;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }
    }
}
events { worker_connections 65535; multi_accept on; use epoll; }
pid /tmp/nginx-mock.pid;
