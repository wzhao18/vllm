+def tokenspeed_mla_var_split_counts(
+    seq_lens: torch.Tensor,
+    max_split_kv: int,
+    num_heads: int,
+    q_len: int,
+    dtype: torch.dtype = torch.float8_e4m3fn,
+) -> torch.Tensor:
+    """Per-request split counts for ``tokenspeed_mla_decode(max_split_kv=...)``
+    (int32 [B], on the device, CUDA-graph safe): proportional to each
+    request's KV tiles, the longest request getting ``max_split_kv``, with no
+    empty split. Compute once and pass as ``block_split_kvs`` to every layer
+    of a step."""
+    mma_qk_tiler_mn, _ = select_mla_decode_tilers(
+        num_heads,
+        q_len,
+        is_fp8=dtype == torch.float8_e4m3fn,
+        compute_capability=torch.cuda.get_device_capability(seq_lens.device),
+    )
+    return _var_split_counts(seq_lens.to(torch.int32), max_split_kv, mma_qk_tiler_mn[1])
+
+
+def _var_split_counts(cache_seqs: torch.Tensor, max_split_kv: int, tile_n: int) -> torch.Tensor:
+    # ceil(tiles / ceil(tiles / s)) == s for the returned s: no empty split.
+    k_tiles = ((cache_seqs + (tile_n - 1)) // tile_n).clamp_(min=1)
+    max_tiles = k_tiles.amax()
+    s = (k_tiles * max_split_kv + max_tiles - 1) // max_tiles
+    s = torch.minimum(s.clamp_(1, max_split_kv), k_tiles)
+    per = (k_tiles + s - 1) // s
+    return ((k_tiles + per - 1) // per).to(torch.int32)
+
+
