+_CLKP: dict = {}  # clkp diagnostic: device index -> [pinned int64 [256, 4], call counter]
+
+
+def _clkp_stamp(dev: int) -> int:
+    """clkp knob: a per-call 32-byte slot of a host-pinned buffer (a CUDA-graph capture
+    keeps one slot per captured call); a daemon thread writes every slot with its
+    SM clock (cycles / ns) to runs/P-MLA/clkp/<host>-<pid>.txt every 5 s."""
+    ent = _CLKP.get(dev)
+    if ent is None:
+        ent = _CLKP[dev] = [torch.zeros((256, 4), dtype=torch.int64, pin_memory=True), 0]
+        if len(_CLKP) == 1:
+            import os
+            import socket
+            import threading
+            import time
+            out = "/lustre/fsw/coreai_comparch_inferencex/weizha/k31ws/runs/P-MLA/clkp"
+
+            def dump():
+                while True:
+                    time.sleep(5)
+                    try:
+                        os.makedirs(out, exist_ok=True)
+                        lines = []
+                        for d, (b, n) in list(_CLKP.items()):
+                            for i, (cyc, ns, ctas, _) in enumerate(b.tolist()):
+                                if ns > 0:
+                                    lines.append(f"dev {d} slot {i} ctas {ctas} cycles {cyc} "
+                                                 f"ns {ns} MHz {1000.0 * cyc / ns:.1f}")
+                        fn = f"{out}/{socket.gethostname()}-{os.getpid()}.txt"
+                        with open(fn + ".tmp", "w") as f:
+                            f.write("\n".join(lines) + "\n")
+                        os.replace(fn + ".tmp", fn)
+                    except Exception:
+                        pass
+
+            threading.Thread(target=dump, daemon=True).start()
+    slot = ent[1] % 256
+    ent[1] += 1
+    return ent[0].data_ptr() + 32 * slot
+
