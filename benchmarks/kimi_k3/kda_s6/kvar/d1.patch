+def _smem8(dtype, addr):
+    """Eight contiguous elements at a 16-byte aligned shared-memory address."""
+    return cute.make_tensor(
+        cute.make_ptr(dtype, addr, cute.AddressSpace.smem, assumed_align=16),
+        cute.make_layout((8,)),
+    )
+
+
+@dsl_user_op
+def _widen_bf16x8(src, dst, *, loc=None, ip=None):
+    """BF16 -> FP32 for eight packed values with one shift or mask each."""
+    words = cute.recast_tensor(src, cutlass.Int32)
+    for w in range(4):
+        res = llvm.inline_asm(
+            llvm.StructType.get_literal([T.f32()] * 2),
+            [words[w].ir_value(loc=loc, ip=ip)],
+            "{\n.reg .b32 lo, hi;\nshl.b32 lo, $2, 16;\n"
+            "and.b32 hi, $2, 0xffff0000;\nmov.b32 $0, lo;\nmov.b32 $1, hi;\n}",
+            "=f,=f,r",
+            has_side_effects=False,
+            is_align_stack=False,
+            asm_dialect=llvm.AsmDialect.AD_ATT,
+            loc=loc,
+            ip=ip,
+        )
+        for h in range(2):
+            dst[2 * w + h] = cutlass.Float32(
+                llvm.extractvalue(T.f32(), res, [h], loc=loc, ip=ip)
+            )
+
